import java.util.*;
public class main{
    public static void main(String[]args){
        Scanner SC =new Scanner(System.in);
        int a =SC.nextInt();
        int b =SC.nextInt();
        System.out.println(a+b);
        System.out.println(a-b);
        System.out.println(a*b);
        System.out.println(a/b);
        System.out.println(a%b);
    }
}
